# Caddy inside the site container: plain HTTP only, the server's Caddy sits in front (HTTPS, domain).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# Hashed file names: cached for a year. Everything else is revalidated.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@static path /models/* /images/* /og/* /favicon.svg
	header @static Cache-Control "public, max-age=86400"

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
