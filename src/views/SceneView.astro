---
// Page of the 3D scene (contracts/scene-page.md). Everything readable is HTML rendered here
// from the content source; the 3D is loaded afterwards by src/scene/boot.ts.
import { existsSync, readdirSync } from 'node:fs';
import { sep } from 'node:path';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SceneItemList from '../components/scene/SceneItemList.astro';
import ScenePanel from '../components/scene/ScenePanel.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { findById, getSite } from '../content';
import { alternateOf, urlFor, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { breadcrumb, graph } from '../lib/jsonld';
import { buildManifest } from '../lib/scene-manifest';

interface Props {
  lang: Lang;
  /** Room model to load instead of public/models/room.glb (style mockups, spec 003). */
  roomUrl?: string;
  /** Baked day / night textures of that room (style mockups, spec 003). */
  bakedMaps?: { day: string; night: string };
}

const { lang, roomUrl, bakedMaps } = Astro.props;
const site = await getSite();

// Covers shown on the generic project objects, optimized ahead (buildManifest is sync).
const covers = new Map<ImageMetadata, string>();
for (const p of site.projects) {
  if (p.cover)
    covers.set(
      p.cover.image,
      (await getImage({ src: p.cover.image, width: 512, format: 'webp' })).src,
    );
}
const items = buildManifest(site, lang, (image) => covers.get(image)!);

// Model files that exist in public/models/, so the browser never asks for a missing one.
const models = existsSync('public/models')
  ? readdirSync('public/models', { recursive: true, encoding: 'utf8' })
      .map((p) => p.split(sep).join('/'))
      .filter((p) => p.endsWith('.glb'))
  : [];

const title = t(lang, 'scene.title');
const path = urlFor('scene', lang);
const jsonLd = graph(
  breadcrumb(Astro.site!, [
    { name: t(lang, 'nav.home'), path: urlFor('home', lang) },
    { name: title, path },
  ]),
);
---

<BaseLayout
  lang={lang}
  title={title}
  description={t(lang, 'scene.description', { name: site.profile.name })}
  canonicalPath={path}
  alternatePath={alternateOf('scene', lang)}
  jsonLd={jsonLd}
>
  <div
    class="container scene-page"
    data-lang={lang}
    data-room-url={roomUrl}
    data-baked-day={bakedMaps?.day}
    data-baked-night={bakedMaps?.night}
  >
    <header class="scene-header">
      <h1>{title}</h1>
      <p>
        {t(lang, 'scene.intro')}
        <a href={urlFor('home', lang)} class="written-link">
          {t(lang, 'scene.written')}
        </a>
      </p>
    </header>

    <div class="scene-wrap">
      <div id="scene" class="scene" aria-busy="true">
        <!-- Without JavaScript the "needs JavaScript" message shows; the inline script swaps it. -->
        <script is:inline>
          document.documentElement.classList.add('js');
        </script>
        <p class="scene-status" role="status">
          <span class="when-js">{t(lang, 'scene.loading')}</span>
          <span class="when-no-js">
            {t(lang, 'scene.noscript')}{' '}
            <a href={urlFor('home', lang)}>{t(lang, 'scene.written')}</a>
          </span>
        </p>
      </div>
      <div class="scene-toolbar">
        <ThemeToggle lang={lang} class="scene-theme" />
        <button type="button" class="scene-recenter" data-recenter hidden>
          {t(lang, 'scene.recenter')}
        </button>
      </div>
      <div class="scene-tooltip" aria-hidden="true" hidden></div>
      <div class="scene-panels">
        {items.map((item) => {
          if (item.type === 'project')
            return (
              <ScenePanel
                lang={lang}
                item={item}
                type="project"
                project={findById(site.projects, item.id)!}
              />
            );
          if (item.type === 'education')
            return (
              <ScenePanel
                lang={lang}
                item={item}
                type="education"
                education={findById(site.education, item.id)!}
              />
            );
          return (
            <ScenePanel
              lang={lang}
              item={item}
              type="experience"
              experience={findById(site.experience, item.id)!}
            />
          );
        })}
        <article
          id="panel-overflow"
          class="scene-panel"
          aria-labelledby="panel-overflow-title"
          hidden
        >
          <button type="button" class="close" data-close aria-label={t(lang, 'scene.close')}>
            ×
          </button>
          <h2 id="panel-overflow-title"></h2>
          <ul class="overflow-list"></ul>
        </article>
      </div>
      <p class="visually-hidden" aria-live="polite" data-announce></p>
    </div>

    <SceneItemList lang={lang} items={items} />
  </div>

  <script type="application/json" id="scene-manifest" set:html={JSON.stringify(items)} />
  <script type="application/json" id="scene-models" set:html={JSON.stringify(models)} />
  <script
    type="application/json"
    id="scene-labels"
    set:html={JSON.stringify({
      canvas: t(lang, 'scene.canvas'),
      opened: t(lang, 'scene.opened'),
      loading: t(lang, 'scene.loading'),
      fallbackWebgl: t(lang, 'scene.fallback.webgl'),
      fallbackError: t(lang, 'scene.fallback.error'),
      retry: t(lang, 'scene.fallback.retry'),
      slow: t(lang, 'scene.fallback.slow'),
      stay: t(lang, 'scene.fallback.stay'),
      choiceTitle: t(lang, 'scene.choice.title'),
      choiceText: t(lang, 'scene.choice.text'),
      choiceContinue: t(lang, 'scene.choice.continue'),
      written: t(lang, 'scene.written'),
      writtenHref: urlFor('home', lang),
      overflow: {
        project: t(lang, 'scene.overflow.project'),
        education: t(lang, 'scene.overflow.education'),
        experience: t(lang, 'scene.overflow.experience'),
      },
    })}
  />
  <script>
    import { start } from '../scene/boot';
    // Let the page content paint first, then load the 3D (FR-002).
    const run = () => void start();
    if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: 1500 });
    else setTimeout(run, 200);
  </script>
</BaseLayout>

<style>
  .scene-page {
    padding-top: var(--space-l);
  }
  .scene-header p {
    color: var(--color-muted);
  }
  .written-link {
    margin-left: var(--space-xs);
    white-space: nowrap;
  }
  .scene-wrap {
    position: relative;
    margin-top: var(--space-m);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
  }
  .scene {
    position: relative;
    height: clamp(22rem, 68vh, 46rem);
    touch-action: none;
  }
  .scene :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    outline: none;
  }
  /* Global: boot.ts also creates this box, without the component's scoped attribute. */
  .scene :global(.scene-status) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: var(--space-l);
    text-align: center;
    color: var(--color-muted);
  }
  /* Choice screen, fallback messages and the "too slow" notice (US4), built by boot.ts. */
  .scene :global(.scene-status h2) {
    font-size: var(--step-1);
  }
  .scene :global(.scene-status > div) {
    max-width: 30rem;
  }
  :global(.scene-actions) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin: var(--space-s) 0 0;
  }
  :global(.scene-actions button),
  :global(.scene-actions a) {
    display: inline-block;
    padding: var(--space-xs) var(--space-m);
    font: inherit;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  :global(.scene-actions button:first-child) {
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .scene-wrap :global(.scene-notice) {
    position: absolute;
    z-index: 4;
    top: var(--space-s);
    left: 50%;
    width: min(26rem, calc(100% - 2 * var(--space-s)));
    padding: var(--space-s) var(--space-m);
    text-align: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-1);
    transform: translateX(-50%);
  }
  .scene-wrap :global(.scene-notice p) {
    margin: 0;
  }
  .scene-toolbar {
    position: absolute;
    right: var(--space-s);
    bottom: var(--space-s);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .scene-toolbar :global(.scene-theme) {
    background: var(--color-surface);
  }
  .scene-recenter {
    padding: var(--space-xs) var(--space-m);
    font: inherit;
    font-size: var(--step--1);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  .scene-tooltip {
    position: absolute;
    z-index: 2;
    max-width: 16rem;
    padding: var(--space-2xs) var(--space-s);
    font-size: var(--step--1);
    color: var(--color-bg);
    background: var(--color-text);
    border-radius: var(--radius);
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 12px));
  }
  /* Panels: anchored next to the object on wide screens, bottom sheet on phones. */
  .scene-panels :global(.scene-panel) {
    position: absolute;
    z-index: 3;
    width: min(22rem, calc(100% - 2 * var(--space-s)));
    max-height: calc(100% - 2 * var(--space-s));
    overflow: auto;
    padding: var(--space-m);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-2);
  }
  .scene-panels :global(.scene-panel[hidden]) {
    display: none;
  }
  .scene-panels :global(.scene-panel h2) {
    font-size: var(--step-1);
    padding-right: var(--space-l);
  }
  .scene-panels :global(.scene-panel .cover) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: calc(var(--radius) / 1.5);
    margin-bottom: var(--space-s);
  }
  .scene-panels :global(.summary),
  .scene-panels :global(.org) {
    color: var(--color-muted);
  }
  .scene-panels :global(dl) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2xs) var(--space-s);
    margin: 0 0 var(--space-s);
    font-size: var(--step--1);
  }
  .scene-panels :global(dt) {
    font-weight: 600;
    color: var(--color-muted);
  }
  .scene-panels :global(dd) {
    margin: 0;
  }
  .scene-panels :global(.close) {
    position: absolute;
    top: var(--space-xs);
    right: var(--space-xs);
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--color-text);
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }
  .scene-panels :global(.more) {
    margin: var(--space-s) 0 0;
    font-weight: 600;
  }
  .scene-panels :global(.overflow-list) {
    padding-left: var(--space-m);
  }
  .scene-panels :global(.overflow-list button) {
    font: inherit;
    color: var(--color-accent-text);
    text-decoration: underline;
    background: none;
    border: 0;
    padding: var(--space-2xs) 0;
    cursor: pointer;
    text-align: left;
  }
  @media (max-width: 40rem) {
    .scene-panels :global(.scene-panel) {
      left: 0 !important;
      right: 0;
      top: auto !important;
      bottom: 0;
      width: 100%;
      max-height: 70%;
      border-radius: var(--radius) var(--radius) 0 0;
    }
    /* A flatter cover leaves room for the text in the bottom sheet. */
    .scene-panels :global(.scene-panel .cover) {
      aspect-ratio: 16 / 7;
    }
  }
  :global(html.js) .when-no-js,
  :global(html:not(.js)) .when-js {
    display: none;
  }
  .scene-noscript {
    margin-top: var(--space-m);
    padding: var(--space-m);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
  }
</style>
