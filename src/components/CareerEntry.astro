---
// One block of the career page: the dates on the left, then the role(s) with their one-line summary,
// technologies and a link to the detail page. Several roles in the same organization are
// stacked under the organization name.
import type { PeriodT } from '../content/schemas';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import Period from './Period.astro';

export interface CareerRole {
  title: string;
  period: PeriodT;
  tag?: string | undefined;
  href: string;
  technologies: string[];
  summary: string;
}

interface Props {
  lang: Lang;
  organization: string;
  location: string;
  period: PeriodT;
  roles: CareerRole[];
}

const { lang, organization, location, period, roles } = Astro.props;
const single = roles.length === 1;
const first = roles[0]!;
---

<li class:list={['career-entry', { ongoing: !period.end }]}>
  <div class="entry-dates">
    <Period lang={lang} period={period} />
  </div>
  <div class="entry-main">
    <h3 class="entry-title">{single ? first.title : organization}</h3>
    <p class="entry-org">
      {single && (
        <>
          {organization}
          {first.tag && <span class="entry-tag">{first.tag}</span>}
        </>
      )}
      {!single && <span class="entry-place">{location}</span>}
    </p>
    {single && <p class="entry-place">{location}</p>}

    {roles.map((role) => (
      <div class:list={['role', { stacked: !single }]}>
        {!single && (
          <>
            <h4 class="role-title">{role.title}</h4>
            <p class="role-period">
              <Period lang={lang} period={role.period} />
              {role.tag && <span class="entry-tag">{role.tag}</span>}
            </p>
          </>
        )}
        <p class="role-summary">{role.summary}</p>
        {role.technologies.length > 0 && (
          <ul class="tags">
            {role.technologies.map((label) => (
              <li>{label}</li>
            ))}
          </ul>
        )}
        <p class="entry-more">
          <a href={role.href}>
            {t(lang, 'career.details')}
            <span class="visually-hidden"> : {role.title}</span> →
          </a>
        </p>
      </div>
    ))}
  </div>
</li>

<style>
  .career-entry {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: var(--space-m) var(--space-l);
    padding: var(--space-l) 0;
    border-top: 1px solid var(--color-border);
  }
  .entry-dates {
    color: var(--color-muted);
    font-size: var(--step--1);
    padding-top: 0.35em;
  }
  /* Ongoing entry: green dot with a soft pulse. */
  .career-entry.ongoing .entry-dates::before {
    content: '';
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: var(--space-xs);
    border-radius: 3px;
    background: var(--color-ongoing);
    box-shadow: 0 0 0 0 var(--color-ongoing);
    animation: pulse 1.8s ease-out infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-ongoing) 70%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 8px transparent;
    }
  }
  /* Reduced motion: no growing ring, only a slow fade of the dot itself, which does not move.
     `!important` overrides the global reduced-motion reset in base.css. */
  @keyframes fade {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .career-entry.ongoing .entry-dates::before {
      animation: fade 2.4s ease-in-out infinite !important;
    }
  }
  .entry-title {
    margin-bottom: var(--space-2xs);
  }
  .entry-org {
    margin: 0;
    font-weight: 600;
    color: var(--color-accent-text);
  }
  .entry-place {
    margin: 0;
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--color-muted);
  }
  .entry-org .entry-place {
    font-size: var(--step-0);
  }
  .entry-tag {
    margin-left: var(--space-xs);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--color-text);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-s);
    padding: 0.05em 0.6em;
  }
  .role {
    margin-top: var(--space-m);
  }
  .role.stacked {
    padding-left: var(--space-m);
    border-left: 2px solid var(--color-border);
  }
  .role-title {
    margin: 0;
  }
  .role-period {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step--1);
  }
  .role-summary {
    margin: var(--space-xs) 0 0;
  }
  .tags {
    margin-top: var(--space-s);
  }
  .entry-more {
    margin: var(--space-s) 0 0;
    font-size: var(--step--1);
    font-weight: 600;
  }
  @media (max-width: 40rem) {
    .career-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xs);
    }
  }
</style>
