---
// Link to the same page in the other language (FR-014).
import { otherLang, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  alternatePath: string;
}

const LANGUAGE_NAMES: Record<Lang, string> = { fr: 'Français', en: 'English' };

const { lang, alternatePath } = Astro.props;
const other = otherLang(lang);
---

<a class="language-switcher" href={alternatePath} hreflang={other} lang={other}>
  <span aria-hidden="true">{other.toUpperCase()}</span>
  <span class="visually-hidden">{LANGUAGE_NAMES[other]}</span>
</a>

<style>
  /* Same size and shape as the theme button next to it. */
  .language-switcher {
    display: inline-grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding-inline: var(--space-xs);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-s);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      border-color var(--duration-fast),
      background-color var(--duration-fast);
  }
  .language-switcher:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-raised);
  }
</style>
