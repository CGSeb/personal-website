---
import { SECTIONS, urlFor, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getSite } from '../content';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  currentPath: string;
  alternatePath: string;
}

const { lang, currentPath, alternatePath } = Astro.props;
const { profile } = await getSite();

const items = [
  { href: urlFor('home', lang), label: t(lang, 'nav.home'), exact: true },
  { href: urlFor('projects', lang), label: t(lang, 'nav.projects') },
  ...(SECTIONS.career ? [{ href: urlFor('career', lang), label: t(lang, 'nav.career') }] : []),
  ...(SECTIONS.contact ? [{ href: urlFor('contact', lang), label: t(lang, 'nav.contact') }] : []),
];
const isCurrent = (item: { href: string; exact?: boolean }) =>
  item.exact ? currentPath === item.href : currentPath.startsWith(item.href);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={urlFor('home', lang)}>
      <span class="brand-mark" aria-hidden="true"></span>
      {profile.name}
    </a>
    <nav aria-label={t(lang, 'nav.label')}>
      <ul>
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
              class:list={{ active: isCurrent(item) }}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <ThemeToggle lang={lang} />
      <LanguageSwitcher lang={lang} alternatePath={alternatePath} />
    </div>
  </div>
</header>

<style>
  /* Style « tour »: the bar sits on a thin amber line, like the LED strip under the room's
     walnut slats. */
  .site-header {
    position: relative;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent) 20%,
      var(--color-accent) 80%,
      transparent
    );
    opacity: 0.7;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-s);
  }
  /* Narrow screens: name and buttons on the first line, the navigation below. */
  nav {
    order: 3;
    width: 100%;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: auto;
  }
  @media (min-width: 48rem) {
    nav {
      order: 0;
      width: auto;
      margin-left: auto;
    }
    .tools {
      margin-left: 0;
    }
    .brand {
      font-size: var(--step-1);
    }
    ul {
      column-gap: var(--space-m);
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }
  .brand-mark {
    width: 0.7em;
    height: 0.7em;
    border-radius: var(--radius-s);
    background: var(--color-accent);
    box-shadow: 0 0 0.6em var(--color-accent);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    padding-block: var(--space-xs);
    color: var(--color-muted);
    font-weight: 500;
    text-decoration: underline 2px transparent;
    text-underline-offset: 0.45em;
    transition:
      color var(--duration-fast),
      text-decoration-color var(--duration-fast);
  }
  nav a:hover {
    color: var(--color-text);
    text-decoration-color: var(--color-border-strong);
  }
  nav a.active {
    color: var(--color-text);
    text-decoration-color: var(--color-accent);
  }
</style>
