---
// Theme button: system -> light -> dark -> system (contracts/theme.md). Hidden without
// JavaScript, where the system setting decides. Several buttons on a page stay in step.
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  data-theme-toggle
  data-state="system"
  data-label-system={t(lang, 'theme.system')}
  data-label-light={t(lang, 'theme.light')}
  data-label-dark={t(lang, 'theme.dark')}
  aria-label={t(lang, 'theme.system')}
  hidden
>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <g class="icon-system">
      <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
    </g>
    <g class="icon-light" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </g>
    <path
      class="icon-dark"
      d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"
      fill="currentColor"
    ></path>
  </svg>
</button>

<script>
  import {
    effectiveTheme,
    nextPreference,
    parsePreference,
    THEME_KEY,
    type Preference,
  } from '../lib/theme';

  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')];
  // ThemeScript.astro already applied the stored choice; it is also the fallback when the
  // storage is blocked, so a choice still holds for the current page.
  let preference: Preference = parsePreference(root.dataset.theme ?? null);

  const label = (button: HTMLButtonElement, pref: Preference) =>
    button.dataset[`label${pref[0]!.toUpperCase()}${pref.slice(1)}`] ?? '';

  const render = () => {
    for (const button of buttons) {
      button.dataset.state = preference;
      button.setAttribute('aria-label', label(button, preference));
      button.hidden = false;
    }
  };

  const announce = () =>
    document.dispatchEvent(
      new CustomEvent('themechange', {
        detail: { theme: effectiveTheme(preference, media.matches) },
      }),
    );

  const choose = (pref: Preference) => {
    preference = pref;
    try {
      if (pref === 'system') localStorage.removeItem(THEME_KEY);
      else localStorage.setItem(THEME_KEY, pref);
    } catch {
      // Storage blocked (private browsing): the choice only holds for this page.
    }
    if (pref === 'system') delete root.dataset.theme;
    else root.dataset.theme = pref;
    render();
    announce();
  };

  for (const button of buttons)
    button.addEventListener('click', () => choose(nextPreference(preference)));
  media.addEventListener('change', () => {
    if (preference === 'system') announce();
  });
  render();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-s);
    cursor: pointer;
    transition:
      border-color var(--duration-fast),
      background-color var(--duration-fast);
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-raised);
  }
  .theme-toggle svg > * {
    display: none;
  }
  .theme-toggle[data-state='system'] .icon-system,
  .theme-toggle[data-state='light'] .icon-light,
  .theme-toggle[data-state='dark'] .icon-dark {
    display: inline;
  }
</style>
