---
// Text list of everything in the scene (FR-020): links to the written pages without
// JavaScript, turned into buttons that open the in-scene panels by the script.
import type { Lang } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import type { ItemType, SceneItem } from '../../scene/layout';

interface Props {
  lang: Lang;
  items: SceneItem[];
}

const { lang, items } = Astro.props;
const groups: ItemType[] = ['project', 'education', 'experience'];
---

<nav class="scene-list" aria-labelledby="scene-list-title">
  <h2 id="scene-list-title">{t(lang, 'scene.listTitle')}</h2>
  <div class="groups">
    {groups.map((type) => {
      const list = items.filter((i) => i.type === type);
      return (
        list.length > 0 && (
          <section>
            <h3>{t(lang, `scene.group.${type}`)}</h3>
            <ul>
              {list.map((item) => (
                <li>
                  <a href={item.href} data-key={item.key}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      );
    })}
  </div>
</nav>

<style>
  .scene-list {
    margin-top: var(--space-xl);
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-l);
  }
  h3 {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li + li {
    margin-top: var(--space-2xs);
  }
  /* Same look for the link (no JavaScript) and the button (enhanced). */
  a,
  :global(.scene-list button) {
    display: inline-block;
    padding: var(--space-2xs) 0;
    font: inherit;
    color: var(--color-text);
    text-align: left;
    text-decoration: underline 1px var(--color-border-strong);
    text-underline-offset: 0.25em;
    background: none;
    border: 0;
    cursor: pointer;
  }
  a:hover,
  :global(.scene-list button:hover),
  :global(.scene-list button[aria-current='true']) {
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }
  :global(.scene-list button[aria-current='true']) {
    font-weight: 700;
  }
</style>
