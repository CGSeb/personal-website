---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import ThemeScript from '../components/ThemeScript.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getSite } from '../content';
import { seoTags } from '../lib/seo';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonicalPath: string;
  /** Path of the same page in the other language (language switcher and hreflang). */
  alternatePath: string;
  jsonLd?: object;
  /** Share image; defaults to the generated image of the language. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
}

const {
  lang,
  title,
  description,
  canonicalPath,
  alternatePath,
  jsonLd,
  ogImage,
  ogImageAlt,
  ogType,
} = Astro.props;
const { profile } = await getSite();
const seo = seoTags({
  site: Astro.site!,
  lang,
  siteName: profile.name,
  title,
  description,
  canonicalPath,
  alternatePath,
  image: ogImage ?? `/og/${lang}.png`,
  imageAlt: ogImageAlt,
  type: ogType,
});
// Style mockups of spec 003 (`astro dev` only); removed with the mockups after the decision.
const mockup = Astro.locals.mockup;
---

<!doctype html>
<html lang={lang} data-style={mockup?.style}>
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {mockup && <meta name="robots" content="noindex, nofollow" />}
    <title>{seo.fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    {seo.og.map((m) => (
      <meta property={m.property} content={m.content} />
    ))}
    {seo.twitter.map((m) => (
      <meta name={m.name} content={m.content} />
    ))}
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t(lang, 'skip')}
    </a>
    {mockup && (
      <div class="mockup-banner" role="note">
        <strong>{t(lang, 'mockup.banner', { style: mockup.name })}</strong>
        {mockup.links.map((link) => (
          <a href={link.href} aria-current={link.current ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </div>
    )}
    <Header lang={lang} currentPath={canonicalPath} alternatePath={alternatePath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .mockup-banner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    padding: var(--space-xs) var(--gutter);
    font-size: var(--step--1);
    color: var(--color-on-accent);
    background: var(--color-accent);
  }
  .mockup-banner a {
    color: inherit;
  }
  .mockup-banner a[aria-current='page'] {
    font-weight: 700;
    text-decoration: none;
  }
</style>
